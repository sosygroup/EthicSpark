# Local development only. Copy to .env and set a unique database password.
DB_PASSWORD=replace-with-a-local-password
APP_PORT=8082
# Optional LLM providers. Keep keys in local .env or private backend configuration, never Git.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional comma-separated model allowlists. Otherwise Load models queries the provider.
OPENAI_MODELS=
ANTHROPIC_MODELS=
OLLAMA_MODELS=
# Ollama running on the Docker host; install models separately.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=
OLLAMA_EXTERNAL=false

# Local models may need several minutes to process the first catalogue prompt.
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_MAX_OUTPUT_TOKENS=8192
# Preference applied only when supported; otherwise the selected model default is used.
# Leave empty to always use the model default.
OLLAMA_REASONING_EFFORT=low

# Retain a used/preloaded Ollama model for 30 minutes (1–240); consumes memory.
OLLAMA_KEEP_ALIVE_MINUTES=30

# Optional OpenAI-compatible provider, independent of official OpenAI.
# Alternatively configure it in Model settings; a saved UI connection overrides these values.
# Base URL includes the API prefix, e.g. https://provider.example/v1.
# Key is optional for unauthenticated servers; arbitrary provider-issued formats are accepted.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODELS=
